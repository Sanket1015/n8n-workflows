    {
      "parameters": {
        "jsCode": "const yesterday = DateTime.now().setZone('Asia/Kolkata').minus({ days: 1 }).toFormat('yyyy-MM-dd');\n\nconst filtered = $input.all().filter(item => {\n  const status = (item.json['Status'] || '').trim();\n  const appointmentDate = (item.json['Appointment Date'] || '').trim();\n  const reengagementSent = (item.json['Re-engagement Sent'] || '').trim();\n  const email = (item.json['Email'] || '').trim();\n\n  return status === 'No-Show' &&\n         appointmentDate === yesterday &&\n         reengagementSent === '' &&\n         email !== '';\n});\n\nif (filtered.length === 0) {\n  return [];\n}\n\nreturn filtered;"
      },
