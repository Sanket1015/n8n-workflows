{
  "name": "Invoice/Receipt Processor",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (let i = 0; i < $input.all().length; i++) {\n  const binaryData = await this.helpers.getBinaryDataBuffer(i, 'attachment_0');\n  const base64String = binaryData.toString('base64');\n  const item = $input.all()[i];\n\n  results.push({\n    json: {\n      base64Pdf: base64String,\n      fileName: item.binary.attachment_0.fileName,\n      mimeType: item.binary.attachment_0.mimeType,\n      emailSubject: item.json.subject,\n      emailDate: item.json.date,\n      emailFrom: item.json.from.text\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "6b8e08e1-7406-4137-a6c7-a8097362c842",
      "name": "PDF to Base64"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"document\",\n          \"source\": {\n            \"type\": \"base64\",\n            \"media_type\": \"application/pdf\",\n            \"data\": \"{{ $json.base64Pdf }}\"\n          }\n        },\n        {\n          \"type\": \"text\",\n          \"text\": \"Extract the following from this invoice or receipt. Respond ONLY with valid JSON, no markdown, no explanation, no backticks. Use this exact structure: {\\\"vendor_name\\\": \\\"\\\", \\\"invoice_number\\\": \\\"\\\", \\\"date\\\": \\\"\\\", \\\"currency\\\": \\\"\\\", \\\"line_items\\\": [{\\\"description\\\": \\\"\\\", \\\"amount\\\": 0}], \\\"subtotal\\\": 0, \\\"tax\\\": 0, \\\"total\\\": 0}. If a field is not found, use null.\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
