{
  "name": "Invoice Daily Summary",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst twentyFourHoursAgo = new Date(now.getTime() - 24 * 60 * 60 * 1000);\n\nconst recentInvoices = $input.all().filter(item => {\n  const processedAt = new Date(item.json['Processed At']);\n  return processedAt >= twentyFourHoursAgo;\n});\n\nif (recentInvoices.length === 0) {\n  return [{\n    json: {\n      hasInvoices: false,\n      message: \"No invoices processed in the last 24 hours.\"\n    }\n  }];\n}\n\nlet totalAmount = 0;\nconst vendors = [];\n\nfor (const inv of recentInvoices) {\n  const total = parseFloat(inv.json['Total']) || 0;\n  const subtotal = parseFloat(inv.json['Subtotal']) || 0;\n  totalAmount += total || subtotal;\n  vendors.push(inv.json['Vendor'] || 'Unknown Vendor');\n}\n\nconst summary = `📊 Daily Invoice Summary\\n\\n`\n  + `Invoices processed: ${recentInvoices.length}\\n`\n  + `Total amount: ${totalAmount.toFixed(2)}\\n`\n  + `Vendors: ${vendors.join(', ')}\\n`\n  + `Period: Last 24 hours`;\n\nreturn [{\n  json: {\n    hasInvoices: true,\n    invoiceCount: recentInvoices.length,\n    totalAmount: totalAmount.toFixed(2),\n    vendors: vendors,\n    message: summary\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
