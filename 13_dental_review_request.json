    {
      "parameters": {
        "jsCode": "const today = DateTime.now().setZone('Asia/Kolkata').toFormat('yyyy-MM-dd');\n\nconst filtered = $input.all().filter(item => {\n  const status = (item.json['Status'] || '').trim();\n  const appointmentDate = (item.json['Appointment Date'] || '').trim();\n  const reviewSent = (item.json['Review Request Sent'] || '').trim();\n  const email = (item.json['Email'] || '').trim();\n\n  return status === 'Completed' &&\n         appointmentDate === today &&\n         reviewSent === '' &&\n         email !== '';\n});\n\nif (filtered.length === 0) {\n  return [];\n}\n\nreturn filtered;"
      },
