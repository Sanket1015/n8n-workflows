    {
      "parameters": {
        "jsCode": "// Helper: safely extract LLM output, return null if the node failed\nfunction getLLMOutput(nodeName) {\n  try {\n    const data = $(nodeName).first().json;\n    if (data.error) return null; // Continue On Fail passes an error object\n    return data.content[0].text;\n  } catch (e) {\n    return null;\n  }\n}\n\nconst linkedin = getLLMOutput('LLM — LinkedIn Post');\nconst tweets = getLLMOutput('LLM — Tweets');\nconst newsletter = getLLMOutput('LLM — Newsletter');\nconst imagePrompt = getLLMOutput('LLM — Image Prompt');\n\nconst outputs = { linkedin, tweets, newsletter, imagePrompt };\nconst succeeded = Object.entries(outputs).filter(([k, v]) => v !== null);\nconst failed = Object.entries(outputs).filter(([k, v]) => v === null);\n\n// If ALL four failed, throw so the error workflow fires\nif (succeeded.length === 0) {\n  throw new Error('All four LLM calls failed. No content generated.');\n}\n\nconst sourceUrl = $('Escape Content for JSON').first().json.source_url;\nconst sourceType = $('Escape Content for JSON').first().json.source_type;\nconst today = new Date().toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' });\nconst docTitle = `Repurposed Content — ${sourceType} — ${today}`;\n\nconst sections = [];\nif (linkedin) sections.push(`═══════════════════════════════\\nLINKEDIN POST\\n═══════════════════════════════\\n\\n${linkedin}`);\nif (tweets) sections.push(`═══════════════════════════════\\nTWEETS\\n═══════════════════════════════\\n\\n${tweets}`);\nif (newsletter) sections.push(`═══════════════════════════════\\nEMAIL NEWSLETTER\\n═══════════════════════════════\\n\\n${newsletter}`);\nif (imagePrompt) sections.push(`═══════════════════════════════\\nIMAGE PROMPT\\n═══════════════════════════════\\n\\n${imagePrompt}`);\n\nconst failedNote = failed.length > 0\n  ? `\\n\\n⚠️ PARTIAL RESULT: ${failed.map(([k]) => k).join(', ')} failed to generate.\\n`\n  : '';\n\nconst docBody = `Source: ${sourceUrl}\\nType: ${sourceType}\\nGenerated: ${today}\\n` +\n  `Outputs: ${succeeded.length}/4 succeeded${failedNote}\\n\\n` +\n  sections.join('\\n\\n');\n\nreturn [{\n  json: {\n    title: docTitle,\n    body: docBody,\n    outputs_generated: succeeded.length,\n    failed_outputs: failed.map(([k]) => k)\n  }\n}];"
      },
