      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const escaped = item.json.content\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"')\n    .replace(/\\n/g, '\\\\n')\n    .replace(/\\r/g, '\\\\r')\n    .replace(/\\t/g, '\\\\t');\n  \n  return {\n    json: {\n      ...item.json,\n      escaped_content: escaped\n    }\n  };\n});"
      },
