    {
      "parameters": {
        "jsCode": "const today = DateTime.now().setZone('Asia/Kolkata');\nconst tomorrow = today.plus({ days: 1 }).toFormat('yyyy-MM-dd');\n\nconst filtered = $input.all().filter(item => {\n  const appointmentDate = item.json['Appointment Date'];\n  const status = item.json['Status'];\n  const email = item.json['Email'];\n  const alreadySent = item.json['Last Reminder Sent'];\n  \n  return appointmentDate === tomorrow \n    && status === 'Scheduled' \n    && email && email.trim() !== ''\n    && (!alreadySent || alreadySent.trim() === '');\n});\n\nreturn filtered;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "9fa28a09-af3f-4e72-a37a-136bc7a1ca18",
      "name": "Filter — Tomorrow + Scheduled + Has Email"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1ed90286-622f-4fc8-b479-9dcfb07ff8e9",
              "name": "to",
              "value": "={{ $json.Email }}",
              "type": "string"
            },
            {
              "id": "d7f39f83-0b0b-4b22-9f7c-e72cc1831b36",
              "name": "subject",
              "value": "={{ 'Reminder: Your ' + $json['Appointment Type'] + ' at ' + $json['Clinic Name'] + ' tomorrow at ' + $json['Appointment Time'] }}",
              "type": "string"
            },
            {
              "id": "09b19834-22ae-4545-ba9a-1c4e8ba0731f",
              "name": "body",
              "value": "={{ 'Hi ' + $json['First Name'] + ',\\n\\nThis is a friendly reminder that you have an appointment tomorrow:\\n\\n📋 Appointment: ' + $json['Appointment Type'] + '\\n📅 Date: ' + $json['Appointment Date'] + '\\n🕐 Time: ' + $json['Appointment Time'] + '\\n👨‍⚕️ Dentist: ' + $json['Dentist Name'] + '\\n📍 Clinic: ' + $json['Clinic Name'] + '\\n📞 Phone: ' + $json['Clinic Phone'] + '\\n\\nIf you need to reschedule or cancel, please call us at ' + $json['Clinic Phone'] + ' as soon as possible.\\n\\nWe look forward to seeing you!\\n\\nWarm regards,\\n' + $json['Clinic Name'] }}",
              "type": "string"
            },
            {
              "id": "1baad8e5-a8a0-4101-9f88-fe61f91ea409",
              "name": "patientRow",
              "value": "={{ $json['Patient ID'] }}",
              "type": "string"
            }
          ]
        },
